# Broker process only. Never prefix this key with VITE_ or place it in React.
# This template is documentation; dotnet does not auto-load .env files.
OPENAI_API_KEY=your_key_here

# Optional native JEV action-intent key, never VITE_. Prefer Settings / Actions
# to store a key in Windows Credential Manager. Visual routing uses local LAYA.
# Native process reads JEV_API_KEY, then TYPESAFE_API_KEY, then the saved key.
# No JEV key is required to build or run offline tests. Actions default OFF.
# JEV_API_KEY=your_typesafe_key_here
